{
  "name": "meadow",
  "private": true,
  "version": "0.1.0",
  "description": "A cozy, tiny 3D building game for the web \u2014 draw stone walls and dirt paths across a grassy hill.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vite build && node tests/ui.mjs",
    "typecheck": "tsc --noEmit -p .",
    "check": "npm run typecheck && npm test && npm run test:ui"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
